    },
    {
      "id": "zendesk",
      "type": "cloud",
      "label": "Zendesk Search API",
      "sublabel": "users/search por phone",
      "description": "API de busca de usuários do Zendesk: localiza o cadastro pelo telefone com Basic Auth/OAuth."
    }
